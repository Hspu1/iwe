{
  "version": 3,
  "port": 8080,
  "timeout": "1488ms",
  "cache_ttl": "0s",
  "extra_config": {
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["OPTIONS", "GET", "POST", "PUT", "PATCH"],
      "allow_headers": ["Origin", "Accept", "Content-Type", "Authorization"],
      "expose_headers": ["Content-Length"],
      "max_age": "12h"
    }
  },
  "endpoints": [
    {{ template "iwe_endpoints.tmpl" (marshal (dict "Method" "GET" "Prefix" "/v1/iwe")) }},
    {{ template "iwe_endpoints.tmpl" (marshal (dict "Method" "POST" "Prefix" "/v1/iwe")) }},
    {{ template "iwe_endpoints.tmpl" (marshal (dict "Method" "PATCH" "Prefix" "/v1/iwe")) }}
  ]
}
