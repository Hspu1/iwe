{
  "version": 3,
  "port": 8080,
  "timeout": "1488ms",
  "cache_ttl": "0s",
  "extra_config": {
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["OPTIONS", "GET", "POST", "PUT", "PATCH"],
      "allow_headers": ["Origin", "Accept", "X-User-Id", "Content-Type", "Authorization"],
      "expose_headers": ["Content-Length"],
      "max_age": "12h"
    }
  },
  "endpoints": [
    {{- range $i, $r := .endpoints.list -}}
    {{- if $i }},{{- end }}
    {
      "endpoint": "{{ $r.endpoint }}",
      "method": "{{ $r.method }}",
      "output_encoding": "no-op",
      "input_headers": ["X-User-Id", "Content-Type"],
      "backend": [
        { 
          "url_pattern": "{{ $r.backend_url }}", 
          "host": ["{{ $r.host }}"]
        }
      ]
    }
    {{- end }}
  ]
}
